# Gmail SMTP settings (use a Gmail App Password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=replace-with-gmail-app-password
ALERT_FROM_EMAIL=your-gmail@gmail.com
ALERT_TO_EMAIL=your-gmail@gmail.com

# Binance scanner settings
BINANCE_MARKET=spot
QUOTE_ASSET=USDT
KLINE_INTERVAL=1h
RSI_PERIOD=6
RSI_THRESHOLD=20

# Runtime
LOG_LEVEL=INFO
DATABASE_PATH=data/alerts.sqlite3
